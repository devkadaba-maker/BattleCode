+int queen_escape_depth(Controller const& controller, Position start,
+                       std::vector<Position>& trail, std::vector<Position> const& forecast, int remaining) {
+    if (!remaining) return 0;
+    auto const* tile = controller.get_tile(start);
+    if (!tile) return remaining; // An unseen continuation is not a known trap.
+    int best = 0;
+    for (Direction direction : Direction::get_direction_list()) {
+        auto const& edge = tile->get_edge(direction);
+        if (!edge.is_passable() || edge.is_portal()) continue;
+        Position next = start.add_dir(direction);
+        if (std::find(trail.begin(), trail.end(), next) != trail.end() ||
+            std::find(forecast.begin(), forecast.end(), next) != forecast.end()) continue;
+        auto const* ahead = controller.get_tile(next);
+        if (occupied(ahead)) continue;
+        trail.push_back(next);
+        best = std::max(best, 1 + queen_escape_depth(controller, next, trail, forecast, remaining - 1));
+        trail.pop_back();
+        if (best == remaining) break;
+    }
+    return best;
+}
+
+std::array<int, 4> opening_queen_escape_scores(Controller const& controller, Game const& game_state) {
+    std::array<int, 4> scores{};
+    if (controller.get_id() >= 2 || game_state.get_round_num() >= QUEEN_ESCAPE_ROUNDS) return scores;
+    if constexpr (QUEEN_ESCAPE_SCOPE == 1) {
+        if (game_state.width != 64 || game_state.height != 64) return scores;
+    }
+    std::vector<Position> forecast;
+    for (auto const& tile : controller.get_tiles()) {
+        auto const* head = tile.get_dragon();
+        if (!head || !head->is_head() || head->get_id() == controller.get_id()) continue;
+        auto const& edge = tile.get_edge(head->get_dir());
+        if (edge.is_passable() && !edge.is_portal()) forecast.push_back(head->get_position().add_dir(head->get_dir()));
+    }
+    for (Direction direction : Direction::get_direction_list()) {
+        if (!safe_step(controller, game_state, controller.get_position(), direction)) continue;
+        Position target = controller.get_position().add_dir(direction);
+        if (std::find(forecast.begin(), forecast.end(), target) != forecast.end()) continue;
+        std::vector<Position> trail{controller.get_position(), target};
+        scores[direction_index(direction)] = 1 + queen_escape_depth(controller, target, trail, forecast, 5);
+        // Stop paying for extra path length once the immediate escape budget
+        // is met. Adequate routes keep their original food/congestion ordering.
+        if constexpr (QUEEN_ESCAPE_THRESHOLD > 0) {
+            int horizon = QUEEN_ESCAPE_THRESHOLD == 2 ? std::min(6, controller.get_length() + 1) : 3;
+            scores[direction_index(direction)] = std::min(scores[direction_index(direction)], horizon);
+        }
+    }
+    return scores;
