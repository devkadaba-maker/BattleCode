+int collector_sonar_intercept_value(Controller const& controller, Game const& game_state, Position start) {
+    if constexpr (COLLECTOR_SONAR_WEIGHT == 0) return 0;
+    if (!target_memory.has_value() || target_memory->local ||
+        controller.get_unit_count() < population_target(controller, game_state) ||
+        controller.get_length() > HUNTER_MAX_LENGTH || is_flagship(controller, game_state)) return 0;
+    int age = target_packet_age(target_memory->packet, game_state.get_round_num());
+    auto target = target_intercept_position(target_memory->packet, game_state);
+    if (age < 0 || age > 1 || game_state.get_round_num() >= 380 || !target.has_value() ||
+        mobility(controller, game_state, start) < 2 || enemy_collision_risk(controller, game_state, start)) return 0;
+    int before = distance(controller.get_position(), *target, game_state);
+    int after = distance(start, *target, game_state);
+    if (before > 12 || after >= before) return 0;
+    return (before - after) * COLLECTOR_SONAR_WEIGHT + std::max(0, 12 - after);
+}
