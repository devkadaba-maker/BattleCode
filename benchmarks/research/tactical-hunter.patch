 Role movement_role(Controller const& controller, Game const& game_state, bool special) {
-    (void)controller;
-    (void)game_state;
-    (void)special;
+#if TACTICAL_HUNTER_MODULO > 0
+    if (!special && controller.get_id() >= 2 && controller.get_length() < 16 &&
