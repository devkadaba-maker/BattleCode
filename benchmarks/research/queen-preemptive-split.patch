@@ -865,0 +869,19 @@
+bool should_preemptively_split_queen() {
+    if constexpr (PREEMPTIVE_QUEEN_SPLIT == 0) return false;
+    if (ct->get_id() >= 2 || ct->get_length() < 4 ||
+        parent_split_count >= QUEEN_SPLIT_LIMIT || parent_split_count >= PARENT_SPLIT_LIMIT ||
+        game->get_round_num() >= 460 || ct->get_unit_count() >= game->unit_limit || !ct->can_split(2)) return false;
+    int exits = 0;
+    int onward = 0;
+    for (Direction direction : Direction::get_direction_list()) {
+        Position target = ct->get_position().add_dir(direction);
+        if (!safe_step(*ct, *game, ct->get_position(), direction) || recent_collision(target)) continue;
+        ++exits;
+        onward = mobility(*ct, *game, target);
+    }
+    // A split one turn before complete entrapment releases two tail segments.
+    // Mode 1 handles only a provable zero-onward exit; mode 2 also handles a
+    // one-onward corridor. Both preserve the existing per-parent split cap.
+    return exits == 1 && (onward == 0 || PREEMPTIVE_QUEEN_SPLIT >= 2 && onward == 1);
+}
