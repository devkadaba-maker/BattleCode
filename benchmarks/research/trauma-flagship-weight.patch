@@ -53,6 +53,9 @@ namespace {
 #ifndef RECENT_REGION_PENALTY
 #define RECENT_REGION_PENALTY 0
 #endif
+#ifndef TRAUMA_FLAGSHIP_PEARL_WEIGHT
+#define TRAUMA_FLAGSHIP_PEARL_WEIGHT 8
+#endif
 #ifndef QUEEN_HUNT
 #define QUEEN_HUNT 0
 #endif
@@ -123,6 +126,7 @@ std::unordered_map<int, int> portal_uses;
 int last_portal_round = -10000;
 const Game* role_map_game = nullptr;
 std::optional<bool> role_map_colosseum;
+std::optional<bool> role_map_trauma;
 int special_pressure_sample_round = -1, special_pressure_sample_count = 0, special_pressure_visible_sum = 0;
 bool special_pressure_enabled = false;
 
@@ -237,6 +241,18 @@ bool colosseum_like(Controller const& controller, Game const& game_state) {
     return *role_map_colosseum;
 }
 
+bool trauma_like(Controller const& controller, Game const& game_state) {
+    if (role_map_game == &game_state && role_map_trauma.has_value()) return *role_map_trauma;
+    if (game_state.width != 48 || game_state.height != 24 || controller.get_id() >= 2) {
+        role_map_trauma = false;
+        return false;
+    }
+    int visible_pearls = 0;
+    for (auto const& tile : controller.get_tiles()) if (tile.has_pearl()) ++visible_pearls;
+    role_map_trauma = visible_pearls == 0;
+    return *role_map_trauma;
+}
+
 int population_target(Controller const& controller, Game const& game_state) {
     if (game_state.width * game_state.height <= 300 && colosseum_like(controller, game_state))
         return std::min(game_state.unit_limit, 40);
@@ -758,6 +774,7 @@ void reset_target_state() {
     last_relay_round = -10000;
     role_map_game = nullptr;
     role_map_colosseum.reset();
+    role_map_trauma.reset();
     special_pressure_sample_round = -1;
     special_pressure_sample_count = 0;
     special_pressure_visible_sum = 0;
@@ -858,7 +875,7 @@ int score_move(Direction direction) {
     // Keep the four-to-five tiebreak flagships collecting pearls in every
     // phase; only smaller dragons switch fully to hunting at the cap.
     if (flagship) {
-        pearl_weight = 8;
+        pearl_weight = trauma_like(controller, game_state) ? TRAUMA_FLAGSHIP_PEARL_WEIGHT : 8;
         chase_weight = 0;
     }
     int score = area * 12 + future_mobility * 12;
