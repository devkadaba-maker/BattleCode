+
+void update_pearl_memory(Controller const& controller, Game const& game_state) {
+    int round = game_state.get_round_num();
+    if (pearl_memory.has_value() &&
+        (round - pearl_memory->last_seen_round > PEARL_MEMORY_TTL ||
+         round - pearl_memory->ready_round > PEARL_MEMORY_TTL)) {
+        pearl_memory.reset();
+    }
+
+    std::optional<PearlMemory> best;
+    int best_value = INT_MIN_SCORE;
+    for (auto const& tile : controller.get_tiles()) {
+        int timer = tile.get_pearl_time();
+        if (!tile.has_pearl() && (timer < 0 || timer > PEARL_MEMORY_TTL)) continue;
+        int wait = tile.has_pearl() ? 0 : timer;
+        int value = (tile.has_pearl() ? 1000 : 400 - wait * 25) -
+            distance(controller.get_position(), tile.get_position(), game_state) * 12;
+        if (!best.has_value() || value > best_value) {
+            best = PearlMemory{tile.get_position(), round + wait, round};
+            best_value = value;
+        }
+    }
+    if (best.has_value()) pearl_memory = best;
+    else if (pearl_memory.has_value()) {
+        auto const* remembered = controller.get_tile(pearl_memory->position);
+        if (remembered && !remembered->has_pearl() && remembered->get_pearl_time() < 0)
+            pearl_memory.reset();
+    }
+}
+
+int remembered_pearl_value(Controller const& controller, Game const& game_state, Position start) {
+    if (!pearl_memory.has_value() || controller.get_tile(pearl_memory->position) ||
+        visible_resource_now(controller)) return 0;
+    int round = game_state.get_round_num();
+    if (round - pearl_memory->last_seen_round > PEARL_MEMORY_TTL ||
+        round - pearl_memory->ready_round > PEARL_MEMORY_TTL) return 0;
+    int before = distance(controller.get_position(), pearl_memory->position, game_state);
+    int after = distance(start, pearl_memory->position, game_state);
+    if (before > PEARL_MEMORY_TTL + 4) return 0;
+    return (before - after) * PEARL_MEMORY_WEIGHT;
+}
