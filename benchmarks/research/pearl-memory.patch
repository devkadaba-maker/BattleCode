diff --git a/tests/pearl_memory_smoke.cpp b/tests/pearl_memory_smoke.cpp
new file mode 100644
index 0000000..4fde245
--- /dev/null
+++ b/tests/pearl_memory_smoke.cpp
@@ -0,0 +1,46 @@
+#define PEARL_MEMORY_WEIGHT 48
+#define PEARL_MEMORY_TTL 8
+#define main battlecode_bot_main
+#include "../cpp_bot/main.cpp"
+#undef main
+
+#include <cassert>
+
+int main() {
+    Game scenario(16, 16, 64);
+    scenario.round_num = 100;
+    game = &scenario;
+    std::vector<Tile> tiles;
+    for (int y = 1; y <= 7; ++y) for (int x = 1; x <= 7; ++x) {
+        std::array<Edge, 4> edges{Edge(false, EdgeType::EMPTY), Edge(false, EdgeType::EMPTY),
+                                  Edge(false, EdgeType::EMPTY), Edge(false, EdgeType::EMPTY)};
+        tiles.emplace_back(Position(x, y), std::nullopt, -1, false, edges);
+    }
+    Controller controller(4, Team(Team::A), Direction::EAST, Vision(std::move(tiles)), 64);
+    controller.head.position = Position(4, 4);
+    controller.length = 6;
+    controller.unit_count = 1;
+    ct = &controller;
+    controller.get_tile(Position(4, 4))->dragon_part =
+        DragonPart(Position(4, 4), 4, Team(Team::A), Direction::EAST, true);
+    reset_target_state();
+
+    pearl_memory = PearlMemory{Position(10, 4), 100, 100};
+    assert(remembered_pearl_value(controller, scenario, Position(5, 4)) > 0);
+    assert(remembered_pearl_value(controller, scenario, Position(3, 4)) < 0);
+
+    // Current visible food takes priority over an uncertain off-screen memory.
+    controller.get_tile(Position(5, 4))->pearl = true;
+    assert(remembered_pearl_value(controller, scenario, Position(5, 4)) == 0);
+    controller.get_tile(Position(5, 4))->pearl = false;
+
+    // Revisiting a remembered tile after it becomes permanently barren clears it.
+    pearl_memory = PearlMemory{Position(6, 4), 100, 100};
+    update_pearl_memory(controller, scenario);
+    assert(!pearl_memory.has_value());
+
+    // Memories expire rather than pulling a collector toward stale food forever.
+    pearl_memory = PearlMemory{Position(10, 4), 100, 100};
+    scenario.round_num = 109;
+    assert(remembered_pearl_value(controller, scenario, Position(5, 4)) == 0);
+}
