+// Assign each visible pearl to the closest friendly head. Stable lower-ID
+// tie-breaking keeps nearby collectors from all choosing the same food.
+bool pearl_claimed_by_friend(Controller const& controller, Game const& game_state, Position pearl) {
+    int our_distance = distance(controller.get_position(), pearl, game_state);
+    for (auto const& tile : controller.get_tiles()) {
+        auto const* dragon = tile.get_dragon();
+        if (!dragon || !dragon->is_head() || dragon->get_team() != controller.get_team() ||
+            dragon->get_id() == controller.get_id()) continue;
+        int their_distance = distance(dragon->get_position(), pearl, game_state);
+        if (their_distance < our_distance ||
+            (their_distance == our_distance && dragon->get_id() < controller.get_id())) return true;
+    }
+    return false;
+}
+#endif
